# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# access token for the "npm run serve" home-screen-app server
server/access-token.txt

# Google Drive OAuth refresh token (npm run gdrive-auth) -- grants upload
# access to your Drive backups folder; never commit this.
server/gdrive-credentials.json

# real user data -- one file per entity, plus automatic backups. Never
# commit this; see DESIGN.md for why it's a separate top-level folder.
/production/
# restore.sh's safety copy of production/ from before a restore
/production-before-restore-*/

# pre-migration data (superseded by /production/, kept only as a paper
# trail) -- same reason, never commit real user data.
server/data.json
server/backups/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
